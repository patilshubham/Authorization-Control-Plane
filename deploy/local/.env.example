# Authorization Control Plane local development settings
# Copy this file to deploy/local/.env before running Docker Compose.
# Values are dev-only placeholders; do not use real secrets or customer data locally.

API_PORT=8080
PORTAL_PORT=5173
POSTGRES_PORT=5432
KEYCLOAK_PORT=8081

POSTGRES_DB=authorization
POSTGRES_USER=authorization
POSTGRES_PASSWORD=authorization_dev_password
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=authorization;Username=authorization;Password=authorization_dev_password

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
# Public issuer (must match the URL the browser uses to reach Keycloak) so tokens validate.
Oidc__Authority=http://localhost:8081/realms/authorization-local
Oidc__Audience=authorization-api
Oidc__PortalClientId=authorization-portal
# Back-channel discovery/JWKS address reachable from the API on the Docker network.
Oidc__MetadataAddress=http://keycloak:8080/realms/authorization-local/.well-known/openid-configuration
Cors__AllowedOrigins__0=http://localhost:5173

Portal__ApiBaseUrl=http://localhost:8080
Portal__OidcAuthority=http://localhost:8081/realms/authorization-local
Portal__OidcAuthorityBase=http://localhost:8081
FeatureFlags__DecisionCachingEnabled=false
Database__RunDevelopmentSetup=true
Database__SeedDevelopmentData=true
Logging__LogLevel__Default=Information

# --- AI assistance (opt-in, advisory only) ---
# Provider options: Fake (deterministic offline stub), OpenAI (OpenAI-compatible / GitHub Models), AzureOpenAI.
# Leave Ai__Enabled=false to keep all AI surfaces absent. To use GitHub Models, set Provider=OpenAI,
# the endpoint below, and paste a GitHub PAT with the "Models: read-only" permission into Ai__AzureOpenAI__ApiKey.
# Never commit a real key.
Ai__Enabled=false
Ai__Provider=OpenAI
Ai__AzureOpenAI__Endpoint=https://models.github.ai/inference
Ai__AzureOpenAI__ApiKey=
Ai__AzureOpenAI__ChatDeployment=openai/gpt-4.1-mini
# Set both to false only for reasoning-style deployments (e.g. gpt-5.5, o-series) that reject a
# non-default temperature and/or the legacy max_tokens field with a hard 400.
Ai__AzureOpenAI__SupportsTemperature=true
Ai__AzureOpenAI__SupportsMaxTokens=true
